# Wheelwright — Local Development Environment
#
# Copy this file to .env and fill in your credentials.
# .env is excluded from git by the root .gitignore.
#
# The dev startup script (scripts/dev.sh) sources this file automatically.

# Tradier API credential (required for live evidence acquisition)
TRADIER_API_KEY=your-tradier-api-key-here

# Provider base URL (default: Tradier sandbox)
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# Wheelwright v2 Bearer auth: generate a private token, use the same value in both.
# ww reads WW_API_TOKEN from the private root .env; explicit exports take precedence.
# scripts/dev.sh exports the backend configuration at startup; restart after changes.
# Never use the placeholder below as a real credential.
# WW_API_TOKEN=replace-with-a-private-random-token
# WHEELWRIGHT_V2_AUTH_TOKENS="${WW_API_TOKEN}=cli:quote.acquire|quote.force"
