# Wheelwright — Local Development Environment
#
# Copy this file to .env and fill in your credentials.
# .env is excluded from git by the root .gitignore.
#
# The dev startup script (scripts/dev.sh) sources this file automatically.

# Tradier API credential (required for live evidence acquisition)
TRADIER_API_KEY=your-tradier-api-key-here

# Provider base URL (default: Tradier sandbox)
TRADIER_BASE_URL=https://sandbox.tradier.com/v1
