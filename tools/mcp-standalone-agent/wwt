#!/bin/bash
# H-003 terminal launcher; the agent owns all model/MCP behavior.
set -e
self=$(realpath "$0")
agent_dir=$(CDPATH= cd "$(dirname "$self")" && pwd -P)

case ${1-} in
  ''|--test|--hello-world) ;;
  *) printf 'Usage: wwt [--test | --hello-world]\n'; exit 2 ;;
esac

command -v node >/dev/null || { printf 'Install Node.js 22 or later first.\n' >&2; exit 1; }
command -v npm >/dev/null || { printf 'Install npm 10 or later first.\n' >&2; exit 1; }
node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' || {
  printf 'Node.js 22 or later is required.\n' >&2; exit 1;
}
for directory in "$agent_dir/../mcp-hello-world" "$agent_dir" "$agent_dir/../mcp-account-question"; do
  if ! env -u OPENAI_API_KEY npm ls --prefix "$directory" --depth=0 >/dev/null 2>&1; then
    printf 'Installing locked dependencies: %s\n' "$(basename "$directory")"
    env -u OPENAI_API_KEY npm ci --prefix "$directory" --ignore-scripts
  fi
done

if [ "${1-}" = --test ]; then
  env -u OPENAI_API_KEY npm test --prefix "$agent_dir"
  exec env -u OPENAI_API_KEY npm test --prefix "$agent_dir/../mcp-account-question"
fi

# The agent reads OPENAI_API_KEY from the existing ignored repository .env.
if [ "${1-}" = --hello-world ]; then
  exec node "$agent_dir/agent.mjs"
fi
exec node "$agent_dir/../mcp-account-question/agent.mjs"
