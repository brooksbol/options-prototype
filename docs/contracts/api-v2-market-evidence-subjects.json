{
  "openapi": "3.1.1",
  "info": {
    "title": "Wheelwright relevant market-evidence subjects",
    "version": "0.1.0",
    "description": "Backend-owned default selection, not a new acquisition mechanism. Principal policy and engineering authorization October 15, 2026."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/v2/market-evidence-subjects": {
      "get": {
        "operationId": "listRelevantMarketEvidenceSubjects",
        "summary": "Select relevant market-evidence subjects",
        "description": "Pure GET, no query/body, provider contact or persistence. Reads latest admitted snapshots via the Position domain service. Failed synchronization never removes prior retained holdings. Nonzero holdings only; supported standard option roots resolve to their underlying. Adjusted Fidelity option roots resolve only through unambiguous same-day retained broker root-to-share mappings with artifact/row provenance; no suffix stripping. Unresolved or conflicting identities report incomplete coverage. Fixed-income holdings have no equity underlying and their exclusion is explicitly qualified. Uppercase canonical underlying identity deduplicates. Nonempty unbound monitoring is unavailable, not silently omitted. Each source retains its clocks/qualifications; selection is not an atomic portfolio snapshot or freshness verdict. Empty complete subjects is a legitimate no-op. Client may transport-batch these subjects through existing POST /v2/quotes; explicit acquisition contract is unchanged.\n\n<!-- internal-only:start -->\nRequires quote.acquire; holdings only from explicit account.positions.read grants. Monitoring reads the existing declared set only with backend wheelwright.market-evidence.monitoring-users visibility binding to immutable User IDs.\n<!-- internal-only:end -->",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-grants": [
          "quote.acquire"
        ],
        "responses": {
          "200": {
            "description": "Complete selection representation; complete=false preserves missing source coverage.",
            "headers": {
              "X-Request-Id": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketEvidenceSubjectSelection"
                },
                "examples": {
                  "synthetic": {
                    "summary": "Invented data only",
                    "value": {
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "selectedAt": "2026-10-15T20:00:00Z",
                      "policy": "AUTHORIZED_HOLDINGS_UNION_CONFIGURED_MONITORING",
                      "complete": false,
                      "subjects": [
                        {
                          "symbol": "EWZ",
                          "sources": [
                            "MONITORING"
                          ]
                        },
                        {
                          "symbol": "XLE",
                          "sources": [
                            "HOLDINGS"
                          ]
                        }
                      ],
                      "coverage": [
                        {
                          "source": "HOLDINGS",
                          "accountId": "acct_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                          "status": "UNAVAILABLE",
                          "snapshotId": null,
                          "evidenceDate": null,
                          "recordedAt": null,
                          "qualifications": [
                            "No admitted holdings observation; absence is not an empty Account."
                          ]
                        },
                        {
                          "source": "HOLDINGS",
                          "accountId": "acct_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                          "status": "AVAILABLE",
                          "snapshotId": "snapshot-22222222-2222-4222-8222-222222222222",
                          "evidenceDate": "2026-10-15",
                          "recordedAt": "2026-10-15T20:00:00Z",
                          "qualifications": [
                            "Latest admitted retained holdings; brokerage freshness and atomic portfolio snapshot are not established."
                          ]
                        },
                        {
                          "source": "MONITORING",
                          "accountId": null,
                          "status": "AVAILABLE",
                          "snapshotId": null,
                          "evidenceDate": null,
                          "recordedAt": null,
                          "qualifications": [
                            "Explicit last-declared monitoring membership; source freshness unknown. Visibility is configured in the backend; no holdings-only substitution."
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Standard v2 request-wide Problem; no acquisition.",
            "headers": {
              "X-Request-Id": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              },
              "WWW-Authenticate": {
                "required": true,
                "schema": {
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "api-v2-direct-quote-acquisition-proposal.yaml#/components/schemas/HeldQuoteReadProblem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 401
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "synthetic": {
                    "summary": "Invented data only",
                    "value": {
                      "type": "urn:wheelwright:problem:unauthenticated",
                      "title": "Unauthenticated",
                      "status": 401,
                      "code": "UNAUTHENTICATED",
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "detail": "Synthetic 401 example."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Standard v2 request-wide Problem; no acquisition.",
            "headers": {
              "X-Request-Id": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "api-v2-direct-quote-acquisition-proposal.yaml#/components/schemas/HeldQuoteReadProblem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 403
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "synthetic": {
                    "summary": "Invented data only",
                    "value": {
                      "type": "urn:wheelwright:problem:forbidden",
                      "title": "Forbidden",
                      "status": 403,
                      "code": "FORBIDDEN",
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "detail": "Synthetic 403 example."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Standard v2 request-wide Problem; no acquisition.",
            "headers": {
              "X-Request-Id": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "api-v2-direct-quote-acquisition-proposal.yaml#/components/schemas/HeldQuoteReadProblem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 422
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "synthetic": {
                    "summary": "Invented data only",
                    "value": {
                      "type": "urn:wheelwright:problem:invalid_request",
                      "title": "Invalid request",
                      "status": 422,
                      "code": "INVALID_REQUEST",
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "detail": "Synthetic 422 example.",
                      "invalidParams": [
                        {
                          "name": "request",
                          "reason": "Synthetic invalid input"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Standard v2 request-wide Problem; no acquisition.",
            "headers": {
              "X-Request-Id": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "api-v2-direct-quote-acquisition-proposal.yaml#/components/schemas/HeldQuoteReadProblem"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": 503
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "synthetic": {
                    "summary": "Invented data only",
                    "value": {
                      "type": "urn:wheelwright:problem:capability_unavailable",
                      "title": "Capability unavailable",
                      "status": 503,
                      "code": "CAPABILITY_UNAVAILABLE",
                      "requestId": "11111111-1111-4111-8111-111111111111",
                      "detail": "Synthetic 503 example."
                    }
                  }
                }
              }
            }
          },
          "405": {
            "$ref": "api-v2-direct-quote-acquisition-proposal.yaml#/components/responses/MethodNotAllowed"
          }
        },
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\s*([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})?\\s*$"
            },
            "description": "Single optional UUID; surrounding whitespace trimmed and echoed. Absent/blank generates one. Invalid or repeated values return 422 after authentication and quote.acquire authorization; errors use a generated UUID. Correlation only, not idempotency.",
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "tags": [
          "Market evidence"
        ],
        "externalDocs": {
          "description": "Product and domain contract",
          "url": "https://github.com/brooksbol/options-prototype/blob/main/docs/design/ww-integrated-update-candidate-2026-10-15/README.md"
        },
        "x-codeSamples": [
          {
            "lang": "curl",
            "label": "Synthetic cURL",
            "source": "curl --request GET 'https://api.example.invalid/v2/market-evidence-subjects' \\\n  --header 'X-Request-Id: 11111111-1111-4111-8111-111111111111'"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "MarketEvidenceSubjectSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "selectedAt",
          "policy",
          "complete",
          "subjects",
          "coverage"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "selectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "policy": {
            "const": "AUTHORIZED_HOLDINGS_UNION_CONFIGURED_MONITORING"
          },
          "complete": {
            "type": "boolean"
          },
          "subjects": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "sources"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "pattern": "^[A-Z^][A-Z0-9.^/_-]{0,31}$"
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "HOLDINGS",
                      "MONITORING"
                    ]
                  }
                }
              }
            }
          },
          "coverage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/MarketEvidenceSourceCoverage"
            }
          }
        }
      },
      "MarketEvidenceSourceCoverage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "accountId",
          "status",
          "snapshotId",
          "evidenceDate",
          "recordedAt",
          "qualifications"
        ],
        "properties": {
          "source": {
            "enum": [
              "HOLDINGS",
              "MONITORING"
            ]
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^acct_[a-f0-9]{32}$"
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "EMPTY",
              "NOT_AUTHORIZED",
              "UNAVAILABLE",
              "INCOMPLETE"
            ]
          },
          "snapshotId": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidenceDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "recordedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "qualifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
