  "StructuralTerms": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "const": "ESTABLISHED"
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractKey",
              "underlyingSymbol",
              "expiration",
              "right",
              "quotedStrike",
              "priceMultiplier",
              "deliverableShares",
              "deliverableCash",
              "exerciseAmount",
              "currency",
              "adjustment",
              "settlement"
            ],
            "properties": {
              "contractKey": {
                "type": "string",
                "minLength": 1
              },
              "underlyingSymbol": {
                "type": "string",
                "minLength": 1
              },
              "expiration": {
                "type": "string",
                "format": "date"
              },
              "right": {
                "type": "string",
                "enum": [
                  "CALL",
                  "PUT"
                ]
              },
              "quotedStrike": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "priceMultiplier": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "deliverableShares": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "deliverableCash": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "exerciseAmount": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "adjustment": {
                "type": "string",
                "enum": [
                  "STANDARD",
                  "ADJUSTED"
                ]
              },
              "settlement": {
                "const": "PHYSICAL_SINGLE_UNDERLYING"
              }
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "CONFLICTING",
              "UNSUPPORTED"
            ]
          },
          "value": {
            "type": "null"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    ],
    "description": "ESTABLISHED requires proven effective terms, positive share deliverable, positive exercise amount/multiplier, nonnegative fixed cash, compatible currency and right. Root/strike encoding or multiplier=100 alone is insufficient. Other settlement models explicitly UNSUPPORTED."
  },
  "StructuralConstituent": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "holdingId",
      "observedContract",
      "custody",
      "signedQuantity",
      "allocationEvidenceIds",
      "terms"
    ],
