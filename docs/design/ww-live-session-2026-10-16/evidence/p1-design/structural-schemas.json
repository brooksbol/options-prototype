      "qualifications": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "description": "Every authorized Account is represented, including no retained snapshot. Missing snapshot implies null snapshot/evidenceSetId and empty structures/evidence, UNAVAILABLE qualification. Selected accepted inventory is conserved across allocated and residual quantities; definitely expired and non-option holdings are out of displayed scope, not proven executed closes."
  },
  "OptionStructureCollection": {
    "type": "object",
    "additionalProperties": false,
    "required": [
