      "inventoryPositionIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "identity": {
        "$ref": "#/components/schemas/StructuralIdentity"
      },
