  "OptionStructure": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "subjectId",
      "inventoryPositionIds",
      "identity",
      "membership",
      "constituents",
      "underlying",
      "expiration",
      "remainingDte",
      "openingFillAt",
      "units",
      "strategy",
      "payoff",
      "range",
      "collateral",
      "qualifications"
