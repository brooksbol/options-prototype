        "minItems": 1,
        "uniqueItems": true
      },
      "terms": {
        "$ref": "#/components/schemas/StructuralTerms"
      }
    }
  },
  "StructuralMembership": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "basis",
      "evidenceIds",
      "reasons"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "ESTABLISHED",
          "UNKNOWN",
          "CONFLICTING"
        ]
      },
      "basis": {
        "type": "string",
        "enum": [
          "EXPLICIT_ASSOCIATION",
          "BROKERAGE_RECONCILIATION",
          "UNASSOCIATED_INVENTORY"
        ]
      },
      "evidenceIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "reasons": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "description": "ESTABLISHED must have nonempty evidenceIds and basis other than UNASSOCIATED_INVENTORY; unknown/conflicting rows have one residual option constituent. Whole-holding old assertions do not establish lifecycle continuity."
  },
