      "holdingId": {
        "type": "string",
        "minLength": 1
      },
      "observedContract": {
        "type": "string",
        "minLength": 1
      },
      "custody": {
        "type": "string",
        "minLength": 1
      },
      "signedQuantity": {
        "type": "string",
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
      },
      "allocationEvidenceIds": {
        "type": "array",
        "items": {
          "type": "string",
