      },
      "evaluatedAt": {
        "type": "string",
        "format": "date-time"
      },
      "evaluationBasis": {
        "const": "RETAINED_INSPECTION"
      },
      "interpretationVersion": {
        "const": "option-structure-v1"
      },
      "accounts": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/StructuralAccount"
        }
      }
    },
    "description": "Pure retained-state domain projection; one SQLite read transaction and evaluation instant for all authorized Accounts. Database consistency is not brokerage snapshot atomicity. No provider calls, writes, durable new identity admission, history read-through or automatic remediation. No live-market, opening economics or order completeness claim."
  }
