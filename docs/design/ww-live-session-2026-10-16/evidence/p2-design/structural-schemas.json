          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "priceCurrency"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "priceCurrency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      {
