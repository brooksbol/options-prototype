          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    ],
    "description": "Knots include x=0 and every positive slope-change point in strictly increasing order; y and right tail determine the continuous function on S>=0. No left/negative-price domain. Premium, basis, fees, tax, funding, cash collateral and execution excluded. Total actual allocated quantity, not per unit. Complete compatible terms required; no partial package payoff."
  },
  "StructuralRange": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "const": "ESTABLISHED"
          },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "lower",
                  "upper"
                ],
                "properties": {
                  "kind": {
                    "const": "SHORT_STRIKE_INTERVAL"
                  },
                  "lower": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  },
                  "upper": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "boundary",
                  "direction"
                ],
                "properties": {
                  "kind": {
                    "const": "SHORT_STRIKE_HALF_LINE"
                  },
                  "boundary": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "AT_OR_ABOVE",
                      "AT_OR_BELOW"
                    ]
                  }
                }
              }
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      {
        "type": "object",
