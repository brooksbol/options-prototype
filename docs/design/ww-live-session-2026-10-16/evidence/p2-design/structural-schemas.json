  "StructuralUnits": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "const": "ESTABLISHED"
          },
          "value": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "CONFLICTING",
              "UNSUPPORTED"
            ]
          },
          "value": {
            "type": "null"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    ],
    "description": "Backend primitive-ratio units: GCD of absolute allocated integer option quantities; +2/-2/-4/+2 =>2 units of +1/-1/-2/+1. Single residual -3 =>3. Units are not count of managed Positions/openings. Invalid quantities cannot be established. Ratios and units are properties of current construction, never occurrence identity."
  },
  "StructuralTerms": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "const": "ESTABLISHED"
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractKey",
              "underlyingSymbol",
              "expiration",
              "right",
              "quotedStrike",
              "priceMultiplier",
              "deliverableShares",
              "deliverableCash",
              "exerciseAmount",
              "currency",
              "adjustment",
              "settlement"
            ],
            "properties": {
              "contractKey": {
                "type": "string",
                "minLength": 1
              },
              "underlyingSymbol": {
                "type": "string",
                "minLength": 1
              },
              "expiration": {
                "type": "string",
                "format": "date"
              },
              "right": {
                "type": "string",
                "enum": [
                  "CALL",
                  "PUT"
                ]
              },
              "quotedStrike": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
              },
              "priceMultiplier": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
              },
              "deliverableShares": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
              },
              "deliverableCash": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "exerciseAmount": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "adjustment": {
                "type": "string",
                "enum": [
                  "STANDARD",
                  "ADJUSTED"
                ]
              },
              "settlement": {
                "const": "PHYSICAL_SINGLE_UNDERLYING"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "adjustment": {
                      "const": "STANDARD"
                    }
                  },
                  "required": [
                    "adjustment"
                  ]
                },
                "then": {
                  "properties": {
                    "priceMultiplier": {
                      "const": "100"
                    },
                    "deliverableShares": {
                      "const": "100"
                    },
                    "deliverableCash": {
                      "const": "0"
                    }
                  }
                }
              }
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "CONFLICTING",
              "UNSUPPORTED"
            ]
          },
          "value": {
            "type": "null"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    ],
    "description": "Positive physical single-underlying terms only. P2 standard-us-equity-v1 admits native Standard/100-share records under the documented adapter product rule. Adjusted acquisition is unsupported in P2; the curve model can represent independently qualified adjusted terms in a later reviewed admission lane."
  },
  "StructuralConstituent": {
    "type": "object",
    "additionalProperties": false,
