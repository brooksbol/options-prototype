              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "value",
          "evidenceIds",
          "reasons"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "CONFLICTING",
              "UNSUPPORTED"
            ]
          },
          "value": {
            "type": "null"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
