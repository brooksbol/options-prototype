  "OptionStructure": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "subjectId",
      "inventoryPositionIds",
      "identity",
      "membership",
      "constituents",
      "underlying",
      "expiration",
      "remainingDte",
      "openingFillAt",
      "units",
      "strategy",
      "payoff",
      "range",
      "collateral",
      "qualifications",
      "associationId"
    ],
    "properties": {
      "subjectId": {
        "type": "string",
        "minLength": 1
      },
      "inventoryPositionIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "identity": {
        "$ref": "#/components/schemas/StructuralIdentity"
      },
      "membership": {
        "$ref": "#/components/schemas/StructuralMembership"
      },
      "constituents": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/StructuralConstituent"
        },
        "minItems": 1
      },
      "underlying": {
        "$ref": "#/components/schemas/StructuralUnderlying"
      },
      "expiration": {
        "$ref": "#/components/schemas/StructuralExpiration"
      },
      "remainingDte": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "openingFillAt": {
        "$ref": "#/components/schemas/StructuralOpening"
      },
      "units": {
        "$ref": "#/components/schemas/StructuralUnits"
      },
      "strategy": {
        "$ref": "#/components/schemas/StructuralStrategy"
      },
      "payoff": {
        "$ref": "#/components/schemas/StructuralPayoff"
      },
      "range": {
        "$ref": "#/components/schemas/StructuralRange"
      },
      "collateral": {
        "$ref": "#/components/schemas/StructuralCollateral"
      },
      "qualifications": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "associationId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "description": "subjectId is a response/snapshot-scoped projection key, never lifecycle identity. identity is established only from proven occurrence + construction boundaries. Unknown expiration remains represented; remainingDte null means unavailable. Clients do not reconstruct membership, identity, quantities or payoff.",
    "allOf": [
      {
        "if": {
          "properties": {
            "membership": {
              "properties": {
                "status": {
                  "const": "ESTABLISHED"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "required": [
            "membership"
          ]
        },
        "then": {
          "properties": {
            "associationId": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "else": {
          "properties": {
            "associationId": {
              "type": "null"
            },
            "constituents": {
              "maxItems": 1
            }
          }
        }
      }
    ]
  },
