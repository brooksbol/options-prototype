    "type": "object",
    "additionalProperties": false,
    "required": [
      "holdingId",
      "status",
      "artifactId",
      "reason"
    ],
    "properties": {
      "holdingId": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "ADMITTED",
          "UNAVAILABLE",
          "UNSUPPORTED",
          "CONFLICTING",
          "NOT_ATTEMPTED"
        ]
      },
      "artifactId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "reason": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "ADMITTED"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
