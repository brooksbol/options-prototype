{
  "StructuralRational": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "numerator",
      "denominator"
    ],
    "properties": {
      "numerator": {
        "type": "string",
        "pattern": "^(?:0|-?[1-9][0-9]*)$"
      },
      "denominator": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "description": "Exact reduced rational; denominator positive. Scalar decoding and viewport interpolation are presentation, not option valuation."
  },
  "StructuralEvidence": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "evidenceId",
      "kind",
      "recordId",
      "artifactId",
      "sha256",
      "sourceRows",
      "sourceEffectiveAt",
      "sourceDate",
      "recordedAt",
      "acquisitionStartedAt",
      "acquisitionReceivedAt"
    ],
    "properties": {
      "evidenceId": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "enum": [
          "HOLDINGS_SNAPSHOT",
          "EXPLICIT_ASSOCIATION",
          "ARTIFACT_ROW",
          "TRANSACTION_OBSERVATION",
          "CONTRACT_TERMS",
          "COVERAGE_ASSERTION"
        ]
      },
      "recordId": {
        "type": "string",
        "minLength": 1
      },
      "artifactId": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "sha256": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "sourceRows": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "uniqueItems": true
      },
      "sourceEffectiveAt": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      },
      "sourceDate": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ]
      },
      "recordedAt": {
        "type": "string",
        "format": "date-time"
      },
      "acquisitionStartedAt": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      },
      "acquisitionReceivedAt": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "description": "Account-scoped evidence references only; no original payload, raw brokerage identifier, order detail or transaction money. IDs confer no artifact/history access. Time precision is not synthesized."
  },
  "StructuralIdentity": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "value",
      "evidenceIds",
      "reasons"
    ],
    "properties": {
      "status": {
        "const": "UNKNOWN"
      },
      "value": {
        "type": "null"
      },
      "evidenceIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "reasons": {
        "type": "array",
        "items": {
          "const": "OCCURRENCE_NOT_ESTABLISHED"
        },
        "minItems": 1,
        "maxItems": 1
      }
    },
    "description": "P2 does not expose affirmative occurrence identity or infer continuity. subjectId and association IDs identify current snapshot projection/claims only; not economic occurrences."
  },
  "StructuralUnderlying": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
