#!/bin/sh
# PATH adapter only. The Node CLI owns argument and credential handling.
self=$0
case $self in
  */*) ;;
  *) self=$(command -v tt) || exit 127 ;;
esac
self=$(realpath "$self") || exit 1
script_dir=$(CDPATH= cd "$(dirname "$self")" && pwd -P) || exit 1
exec node "$script_dir/tastytrade.mjs" "$@"
